{
  "manifest_version": 3,
  "name": "Cyberpunk TCG Coach",
  "version": "0.1.5",
  "description": "Learning coach for cyberpunk-tcg-sim.online: the best move from what you know. Off in Quick Play, public lobbies, Ranked and tournaments.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Cyberpunk TCG Coach" },
  "content_scripts": [
    { "matches": ["https://cyberpunk-tcg-sim.online/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://cyberpunk-tcg-sim.online/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
