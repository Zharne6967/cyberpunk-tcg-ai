{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext",
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "types": [
      "node",
      "@types/bun"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@tcg/card-model": [
        "./src/index.ts"
      ],
      "@tcg/op-types": [
        "../../../one-piece/packages/types/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
